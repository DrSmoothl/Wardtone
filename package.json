{
  "name": "wardtone",
  "productName": "戍声",
  "version": "0.1.0",
  "description": "Wardtone · 卫戍协议语音工作台",
  "author": "戍声",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:fixtures": "vitest run --config vitest.local.config.ts",
    "test:integration": "tsx scripts/verify-local.ts",
    "package:mac": "npm run build && electron-builder --mac zip --arm64 --publish never",
    "package:mac:intel": "npm run build && electron-builder --mac zip --x64 --publish never",
    "package:win": "npm run build && electron-builder --win nsis zip --x64 --publish never"
  },
  "build": {
    "appId": "app.wardtone.desktop",
    "productName": "戍声",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "asar": true,
    "artifactName": "Wardtone-${version}-${os}-${arch}.${ext}",
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "zip"
      ],
      "identity": null,
      "icon": "resources/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@yume-chan/adb": "2.6.4",
    "@yume-chan/stream-extra": "2.6.1",
    "fflate": "0.8.3",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
